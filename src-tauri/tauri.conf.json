{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MSPI Pulse",
  "version": "0.1.0",
  "identifier": "io.mspi.pulse",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../frontend"
  },
  "app": {
    "windows": [{ "title": "MSPI Pulse", "width": 1180, "height": 760, "minWidth": 900, "minHeight": 600 }],
    "trayIcon": { "iconPath": "icons/icon.png", "tooltip": "MSPI Pulse" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "13.0" },
    "windows": { "nsis": { "displayLanguageSelector": false } }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://tools.mspi.io/api/messenger/mac-app/appcast.xml"],
      "dialog": true,
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY"
    },
    "notification": {},
    "globalShortcut": {
      "shortcuts": [{ "id": "quick-open", "shortcut": "CommandOrControl+K", "description": "Quick-open Pulse" }]
    }
  }
}
