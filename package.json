{
  "name": "mspi-tools",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/*/frontend",
    "apps/*/backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "seed": "npm run seed -w @mspi/launcher-backend",
    "db:push": "npm run db:push -w @mspi/launcher-backend",
    "db:generate": "npm run db:generate -w @mspi/launcher-backend",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "concurrently": "^8.2.2"
  },
  "packageManager": "npm@10.9.3"
}
