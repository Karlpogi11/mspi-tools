{
  "name": "mspi-tools",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/*/frontend",
    "apps/*/backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "cd apps/pcount/frontend && ../../../node_modules/.bin/tsc -b && ../../../node_modules/.bin/vite build && cd ../backend && ../../../node_modules/.bin/tsc && cp -r ../frontend/dist dist/public && cd ../..",
    "seed": "npm run seed -w @mspi/launcher-backend",
    "db:push": "npm run db:push -w @mspi/launcher-backend",
    "db:generate": "npm run db:generate -w @mspi/launcher-backend",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.21"
  },
  "packageManager": "npm@10.9.3"
}
