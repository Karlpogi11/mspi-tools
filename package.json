{
  "name": "mspi-tools",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/*/frontend",
    "apps/*/backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "npm exec --workspace=@mspi/pcount-frontend -- tsc -b && npm exec --workspace=@mspi/pcount-frontend -- vite build && npm exec --workspace=@mspi/pcount-backend -- tsc && cp -r apps/pcount/frontend/dist apps/pcount/backend/dist/public",
    "seed": "npm run seed -w @mspi/launcher-backend",
    "db:push": "npm run db:push -w @mspi/launcher-backend",
    "db:generate": "npm run db:generate -w @mspi/launcher-backend",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.21"
  },
  "packageManager": "npm@10.9.3"
}
