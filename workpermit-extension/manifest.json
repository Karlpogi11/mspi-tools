{
  "manifest_version": 3,
  "name": "Work Permit Autofill",
  "version": "0.1.0",
  "description": "Autofills the mall Work Permit form - page 1 (General Information) and page 2 (Work Details).",
  "permissions": ["storage", "scripting", "activeTab", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Work Permit Autofill",
    "default_popup": "popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/helpers.js", "content/fill.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}