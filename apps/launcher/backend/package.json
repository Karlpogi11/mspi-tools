{
  "name": "@mspi/launcher-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build -w @mspi/launcher-frontend && tsc && mkdir -p dist/public && rm -rf dist/public && cp -r ../frontend/dist/. dist/public/",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "db:generate": "drizzle-kit generate --config=./drizzle.config.ts",
    "db:push": "drizzle-kit push --config=./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=./drizzle.config.ts"
  },
  "dependencies": {
    "@mspi/shared-auth": "*",
    "@mspi/shared-db": "*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "express": "^4.21.0",
    "mysql2": "^3.11.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {}
}
