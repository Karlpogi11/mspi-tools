    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "chokidar": "^5.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.1",
    "express-slow-down": "^3.1.0",
    "file-type": "^19.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "pdfjs-dist": "^6.2.108",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.1"
